# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# Research scout providers (httpx is used for both)
TAVILY_API_KEY=tvly-...
NVIDIA_NIM_API_KEY=nvapi-...
# Optional overrides (defaults shown)
# NEMOTRON_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
# NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# App
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
FRONTEND_URL=https://toolpika.vercel.app

# Daily research job (03:00 UTC by default)
CRON_RESEARCH_ENABLED=true
CRON_RESEARCH_SCHEDULE=0 3 * * *
