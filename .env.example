# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# AI Providers
TAVILY_API_KEY=tvly-...
NVIDIA_NIM_API_KEY=nvapi-...
# Optional overrides (defaults shown)
# NEMOTRON_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
# NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
GROQ_API_KEY=gsk_...

# Queue (for delayed translation)
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=...

# App
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Frontend (for CORS and callbacks)
FRONTEND_URL=https://toolpika.vercel.app

# Cron
CRON_RESEARCH_ENABLED=true
CRON_RESEARCH_SCHEDULE=0 3 * * *

# Pipeline tuning
QA_MAX_RETRIES=3
TRANSLATION_DELAY_MINUTES=5
TRANSLATION_CALL_DELAY_SECONDS=1
DEFAULT_LOCALES=de,fr,es,it,pt-BR,ru,tr,ar,hi

# Tool Studio - GitHub PR publishing (apply step)
# Fine-grained PAT needs: Contents=read/write, Pull requests=read/write,
# Metadata=read on the frontend repository.
GITHUB_PAT=github_pat_...
GITHUB_REPO_OWNER=hmzain
GITHUB_REPO_NAME=toolpika-frontend
GITHUB_BASE_BRANCH=main
# Optional: merge the generated PR automatically (default false)
STUDIO_AUTO_MERGE_PR=false
